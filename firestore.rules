rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'displayName', 'isAdmin']) &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.email is string &&
             data.displayName is string &&
             data.isAdmin is bool &&
             (!('themeMode' in data) || data.themeMode is string) &&
             (!('preferredVoice' in data) || data.preferredVoice is string) &&
             (!('modelPreference' in data) || data.modelPreference is string) &&
             (!('photoUrl' in data) || data.photoUrl is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidConversation(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'mode', 'messageCount']) &&
             (!('id' in data) || data.id is string) &&
             data.userId == userId &&
             data.title is string && data.title.size() > 0 &&
             data.mode in ['chat', 'voice', 'vision', 'writing', 'study', 'search', 'image_gen'] &&
             data.messageCount is int && data.messageCount >= 0 &&
             (!('lastMessage' in data) || data.lastMessage is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMessage(data, userId, convId) {
      return data.keys().hasAll(['conversationId', 'userId', 'role', 'content', 'hasImage']) &&
             (!('id' in data) || data.id is string) &&
             data.conversationId == convId &&
             data.userId == userId &&
             data.role in ['user', 'model', 'system'] &&
             data.content is string &&
             data.hasImage is bool &&
             (!('imageUrl' in data) || data.imageUrl is string) &&
             (!('toolUsed' in data) || data.toolUsed is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == "mdfaizu14482@gmail.com");
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);

      match /conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidConversation(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidConversation(request.resource.data, userId);
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidMessage(request.resource.data, userId, conversationId);
          allow update: if isOwner(userId) && isValidMessage(request.resource.data, userId, conversationId);
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
